#  Shared by both services 
DATABASE_URL=            # Neon Postgres connection string (direct, non-pooler)
ENVIRONMENT=development  # development | production

INTERNAL_API_KEY=        # required by ai, min 16 chars

#  Web service
JWT_SECRET=              # required, min 32 chars — app refuses to boot otherwise
JWT_EXPIRES_MIN=1440     # access-token lifetime in minutes
BCRYPT_ROUNDS=12         # password hashing cost (keep sane for 0.1 CPU in prod)
AI_SERVICE_URL=          # http://127.0.0.1:8001 locally, https://<ai>.onrender.com in prod

SEED_ADMIN_EMAIL=admin@store.test
SEED_ADMIN_PASSWORD=Admin#12345

TEST_DATABASE_URL=


SMART_SEARCH_ROUTING_ENABLED=false
SEARCH_TIMEOUT_SECONDS=3.0   # falls back to local full-text search when the AI service is slow

# AI service
# Also uses DATABASE_URL (same Neon as web), ENVIRONMENT and INTERNAL_API_KEY above.
LLM_PROVIDER=ollama              # selects the ILLMClient implementation (application/llm/)
OLLAMA_API_KEY=                  # Ollama Cloud — required to boot
OLLAMA_MODEL=gemma4:31b-cloud    # must support tool calling (agent loop requirement)
OLLAMA_HOST=https://ollama.com   # override to point at a different Ollama endpoint
MCP_BEARER_TOKEN=                # auth for external MCP clients on /mcp — required, min 16 chars
# Guardrails — defaults shown, override as needed
MAX_TOOL_ITERATIONS=5
MAX_TOKENS_PER_REPLY=1024
MAX_MESSAGES_PER_SESSION=40
LLM_TIMEOUT_SECONDS=60
# MCP DNS-rebinding protection (production only): extra allowed Host/Origin values,
# comma-separated. Render's RENDER_EXTERNAL_HOSTNAME is allowed automatically.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=




# Smart search — this service owns retrieval, so the models live here.
#
# Turning it on requires a provider, a model, a key, and EMBEDDING_DIMENSIONS matching the width
# the vector columns were migrated with; it also refuses to boot if the embedding column or the
# client binding is missing. All of that is a boot failure by design — the alternative is a store
# quietly serving lexical results under a flag that claims semantic search.
#
# Still false here. Rollout is §19 (phase 11), and the index carries vectors regardless of this
# flag, so turning it on is instant rather than a cold start.
SMART_SEARCH_ENABLED=false
# Chosen by bake-off on 2026-07-29 against the §15 corpus, not by preference. It tied the best
# Arabic recall and MRR of every candidate and scored the highest nDCG, at half the index width
# of the 1536-dimension options. Ollama Cloud serves no embedding model, which is why this is
# not the chat provider. See SMART_SEARCH_PLAN.md, phase 5.
EMBEDDING_PROVIDER=gemini    # adapter name, not a URL: gemini | openrouter
EMBEDDING_HOST=https://generativelanguage.googleapis.com
EMBEDDING_API_KEY=           # from Google AI Studio; never committed
EMBEDDING_MODEL=gemini-embedding-001   # a separate role from OLLAMA_MODEL, never the same value
# 768 is a Matryoshka truncation of the model's native 3072. It is requested explicitly because
# pgvector will not build an HNSW index above 2000 dimensions. Baked into a migration: changing
# it means re-embedding the whole catalog.
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=2.0
# A second provider, embedded into its own column so failover costs no correctness. Vectors from
# two models are not comparable, so the fallback compares its query against its own column rather
# than the primary's — which is why this is a column and not a retry. Optional; set all three or
# none. It doubles backfill spend while configured.
EMBEDDING_FALLBACK_PROVIDER=   # openrouter
EMBEDDING_FALLBACK_HOST=       # https://openrouter.ai
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=      # openai/text-embedding-3-large
# The breaker that stops every query waiting out the same dead provider (§12). Per provider, and
# it probes recovery on its own.
# EMBEDDING_BREAKER_FAILURES=3
# EMBEDDING_BREAKER_RESET_SECONDS=30.0
RERANKER_PROVIDER=           # chosen after embeddings, which give it a baseline to beat
RERANKER_HOST=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TOP_K=30            # tested range: 20-50
RERANKER_TIMEOUT_SECONDS=1.5 # must fit inside SEARCH_DEADLINE_SECONDS
# Retrieval tuning — defaults shown. Change these, not constants in the code.
# SEARCH_DEADLINE_SECONDS=3.0
# SEARCH_SEMANTIC_CANDIDATES=100
# SEARCH_LEXICAL_CANDIDATES=100
# SEARCH_TRIGRAM_CANDIDATES=50
# SEARCH_TRIGRAM_THRESHOLD=0.3
# SEARCH_RRF_K=60
# SEARCH_RRF_WEIGHT_SEMANTIC=1.0
# SEARCH_RRF_WEIGHT_LEXICAL=1.0
# SEARCH_RRF_WEIGHT_TRIGRAM=0.5
# SEARCH_RELEVANCE_FLOOR=0.0   # over the fused RRF score; 0.0 because rank cannot express "bad"
# The floor that actually keeps unrelated neighbours out (§7.4), applied to cosine similarity
# inside the semantic leg. Calibrated against the §15 corpus on 2026-07-29: every gating case
# passes anywhere in (0.6344, 0.6562], and 0.645 is the midpoint. Both edges are Arabic.
# A property of gemini-embedding-001@768 — changing the model means measuring it again.
# SEARCH_SEMANTIC_MIN_SIMILARITY=0.645
# HNSW's query-side knobs (§14.3). Iterative scan is what stops a filtered query under-returning
# when the approximate index hands back fewer rows than the filters need.
# SEARCH_HNSW_EF_SEARCH=100
# SEARCH_HNSW_ITERATIVE_SCAN=relaxed_order   # off | relaxed_order | strict_order
# How much each part of an indexed document counts. These multiply the weights the index worker
# stores per field (name, then category+origin, then description) and are applied per query, so
# changing them costs nothing and invalidates no stored row.
# SEARCH_LEXICAL_WEIGHT_NAME=1.0
# SEARCH_LEXICAL_WEIGHT_FACET=0.4
# SEARCH_LEXICAL_WEIGHT_DESCRIPTION=0.1
# Index worker: the sweep interval bounds how stale an edited product's document can be,
# because there is no shared transaction with the web service's writes. Turning the worker off
# means maintaining the index with `python -m app.application.jobs.reindex_catalog` instead.
# SEARCH_INDEX_WORKER_ENABLED=true
# SEARCH_INDEX_SWEEP_SECONDS=20.0
# SEARCH_INDEX_BATCH_SIZE=16
# SEARCH_INDEX_POLL_SECONDS=5.0
# SEARCH_INDEX_LEASE_SECONDS=120
# SEARCH_INDEX_MAX_ATTEMPTS=5
# SEARCH_INDEX_BACKOFF_CAP_SECONDS=300.0
# SEARCH_INDEX_SHUTDOWN_SECONDS=10.0
# Below this share of active products having a document, search falls back to the web service's
# own products.search_vector, which is always populated. Not 1.0: one product being reindexed
# must not move the whole store onto the fallback.
# SEARCH_INDEX_MIN_COVERAGE=0.95
# The query-embedding cache (§10.4) — what makes sustained query traffic affordable rather than
# a nicety: an uncached query costs a ~434 ms provider call against a 3 s deadline, and the free
# tier is 1,000 embedding requests a day. Pruned by the index worker on its own long clock.
# SEARCH_QUERY_CACHE_TTL_SECONDS=86400
# SEARCH_QUERY_CACHE_PRUNE_SECONDS=3600
# SEARCH_EVENT_QUERY_RETENTION_DAYS=30
# SEARCH_EVENT_METRIC_RETENTION_DAYS=365
