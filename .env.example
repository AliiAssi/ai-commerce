DATABASE_URL=
ENVIRONMENT=development

INTERNAL_API_KEY=

JWT_SECRET=
JWT_EXPIRES_MIN=1440
BCRYPT_ROUNDS=12
AI_SERVICE_URL=

SEED_ADMIN_EMAIL=admin@store.test
SEED_ADMIN_PASSWORD=Admin#12345

TEST_DATABASE_URL=

SMART_SEARCH_ROUTING_ENABLED=false
SEARCH_TIMEOUT_SECONDS=3.0

ALERTS_DISCORD_WEBHOOK_URL=
ALERTS_MIN_LEVEL=WARNING

# openrouter (default) or ollama. LLM_HOST is optional: each provider has its own default.
# For ollama set LLM_MODEL=gemma4:31b-cloud. The model must support tool calling.
LLM_PROVIDER=openrouter
LLM_HOST=
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
# openrouter only: comma-separated models tried in order when LLM_MODEL is rate-limited or down.
LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
MCP_BEARER_TOKEN=
MAX_TOOL_ITERATIONS=5
MAX_TOKENS_PER_REPLY=1024
MAX_MESSAGES_PER_SESSION=40
MAX_PRODUCT_CARDS=6
STOREFRONT_URL=https://beit-lebanon.vercel.app
LLM_TIMEOUT_SECONDS=60

SMART_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=gemini
EMBEDDING_HOST=https://generativelanguage.googleapis.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=2.0
SEARCH_SEMANTIC_MIN_SIMILARITY=0.645
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_HOST=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=
RERANKER_PROVIDER=
RERANKER_HOST=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TOP_K=30
RERANKER_TIMEOUT_SECONDS=1.5
RERANK_MIN_SCORE=0.005
RERANK_MIN_SCORE_AR=0.003
RERANK_GAP_RATIO=0.35
